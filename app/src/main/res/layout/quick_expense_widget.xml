<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_expense_open" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="top" android:padding="16dp" android:background="@drawable/quick_widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="tally" android:textSize="18sp" android:textStyle="bold" android:textColor="#080B12"/>
        <ImageView android:id="@+id/widget_header_add_icon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_add" android:importantForAccessibility="no"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_add_expense" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/widget_add_expense_icon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_compose" android:importantForAccessibility="no"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="@string/quick_expense_label" android:textSize="15sp" android:textColor="#0066FF"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_favourite_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <ImageView android:id="@+id/widget_favourite_icon_1" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_activity" android:importantForAccessibility="no"/>
        <TextView android:id="@+id/widget_favourite_name_1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:textSize="15sp" android:textColor="#080B12"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_favourite_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <ImageView android:id="@+id/widget_favourite_icon_2" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_activity" android:importantForAccessibility="no"/>
        <TextView android:id="@+id/widget_favourite_name_2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:textSize="15sp" android:textColor="#080B12"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_favourite_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <ImageView android:id="@+id/widget_favourite_icon_3" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_activity" android:importantForAccessibility="no"/>
        <TextView android:id="@+id/widget_favourite_name_3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:textSize="15sp" android:textColor="#080B12"/>
    </LinearLayout>
</LinearLayout>
