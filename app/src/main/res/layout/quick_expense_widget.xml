<!-- Launcher RemoteViews supports framework TextView attributes, not AppCompat widgets. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UseCompatTextViewDrawableXml"
    android:id="@+id/quick_expense_open" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="top" android:padding="16dp" android:background="@drawable/quick_widget_background">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:text="@string/quick_widget_brand" android:textSize="18sp"
        android:textStyle="bold" android:textColor="#080B12" android:drawableEnd="@drawable/ic_add" android:drawableTint="#0066FF"/>
    <TextView android:id="@+id/widget_add_expense" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="48dp" android:gravity="center_vertical" android:drawableStart="@drawable/ic_compose"
        android:drawablePadding="12dp" android:drawableTint="#0066FF" android:text="@string/quick_expense_label"
        android:textSize="15sp" android:textColor="#0066FF"/>
    <TextView android:id="@+id/widget_favourite_1" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="48dp" android:gravity="center_vertical" android:visibility="gone" android:drawableStart="@drawable/ic_activity"
        android:drawablePadding="12dp" android:drawableTint="#0066FF" android:textSize="15sp" android:textColor="#080B12"/>
    <TextView android:id="@+id/widget_favourite_2" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="48dp" android:gravity="center_vertical" android:visibility="gone" android:drawableStart="@drawable/ic_activity"
        android:drawablePadding="12dp" android:drawableTint="#0066FF" android:textSize="15sp" android:textColor="#080B12"/>
    <TextView android:id="@+id/widget_favourite_3" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="48dp" android:gravity="center_vertical" android:visibility="gone" android:drawableStart="@drawable/ic_activity"
        android:drawablePadding="12dp" android:drawableTint="#0066FF" android:textSize="15sp" android:textColor="#080B12"/>
</LinearLayout>
